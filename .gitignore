CLAT/

# Per-run output from the daily current-affairs agent. Regenerated on every run
# and useful only while debugging that run.
CA_Agent_Logs/

# Local git worktrees. Checkouts of this same repository, not content of it.
CLAT Prep Studio.worktrees/

# Rendered evidence pages (604MB) and PDF scratch renders (145MB). Both are
