# Existing Firebase browser configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Legacy deployment setting retained for compatibility with existing environments.
# Account sign-in and registration are always rendered by the current frontend.
VITE_ACCOUNT_FEATURES_MODE=enabled

# Mandatory in production. The Vercel privacy API verifies App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Mandatory notice identity and grievance contact.
VITE_PRIVACY_LEGAL_NAME=SaralPrivacy
VITE_PRIVACY_CONTACT_EMAIL=theintellohelp@gmail.com

# Server-only Current Affairs orchestration
# OPENAI_API_KEY is already managed locally and must also be configured in the
# production server environment. Never expose it with a VITE_ prefix.
CA_OPENAI_MODEL=gpt-5.6-terra
CA_ADMIN_EMAIL=
CA_ALERT_FROM_EMAIL=
CRON_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Vercel Functions only. Never prefix these with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
APP_BASE_URL=https://theintello.com
PARENT_CONSENT_FROM_EMAIL=CLAT Prep Studio <consent@theintello.com>
PARENT_CONSENT_REPLY_TO_EMAIL=theintellohelp@gmail.com
RESEND_API_KEY=
ADULT_VERIFICATION_START_URL=
PARENT_VERIFICATION_STATE_SECRET=
ADULT_VERIFICATION_WEBHOOK_SECRET=
CRON_SECRET=
