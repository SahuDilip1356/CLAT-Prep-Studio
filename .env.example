# Existing Firebase browser configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Production safety switch. Start with core_only; change to enabled only after
# consent services and the legacy-user migration pass the release gate.
VITE_ACCOUNT_FEATURES_MODE=core_only

# Mandatory in production. Callable privacy functions enforce App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Mandatory notice identity and grievance contact.
VITE_PRIVACY_LEGAL_NAME=SaralPrivacy
VITE_PRIVACY_CONTACT_EMAIL=privacy@saralprivacy.com
